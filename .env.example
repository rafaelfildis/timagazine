# Copie para .env.local (ignorado pelo git). Produção: as variáveis ficam no painel da Vercel
# (ver docs/operacao/deploy.md), nunca neste repositório.

# Dev local sem Neon: DATABASE_URL=pglite:./.data/dev
DATABASE_URL=

# Auth.js: obrigatório (gere com `npx auth secret`); em produção use um valor real, só no ambiente.
AUTH_SECRET=

# Vercel Blob (imagens do painel). Sem ele o envio de imagens responde 503, a não ser que
# ALLOW_LOCAL_UPLOADS=1 (só desenvolvimento/e2e: grava em public/uploads e serve por /uploads/...).
BLOB_READ_WRITE_TOKEN=
# ALLOW_LOCAL_UPLOADS=1

# URL pública canônica, sem barra no fim (ex.: https://timagazine.com.br). Na Vercel, se vazia,
# usa https://$NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL; em dev cai para http://localhost:3100.
NEXT_PUBLIC_SITE_URL=

# AUTH_TRUST_HOST=true SÓ quando o site roda atrás de proxy/CDN que não seja a Vercel.
# Na Vercel não defina (nem vazia): o Auth.js detecta a plataforma sozinho.
# AUTH_TRUST_HOST=true
